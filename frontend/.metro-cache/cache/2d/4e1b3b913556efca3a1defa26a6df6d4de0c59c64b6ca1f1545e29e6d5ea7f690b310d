======================\n  // REQUEST DTOs\n  // ============================================\n\n  /** Request to create an appointment */\n\n  /** Request to update an appointment */\n\n  /** Request to reschedule an appointment */\n\n  /** Parameters for listing appointments */\n\n  // ============================================\n  // RESPONSE DTOs\n  // ============================================\n\n  /** Response for an appointment */\n\n  /** Paginated response for appointments */\n\n  /** Reschedule response */\n\n  // ============================================\n  // HELPER FUNCTIONS\n  // ============================================\n\n  /** Get display name for appointment status */\n  const getStatusLabel = status => {\n    const labels = {\n      scheduled: 'Scheduled',\n      confirmed: 'Confirmed',\n      in_progress: 'In Progress',\n      completed: 'Completed',\n      cancelled: 'Cancelled',\n      no_show: 'No Show'\n    };\n    return labels[status] || status;\n  };\n\n  /** Get color for appointment status */\n  const getStatusColor = status => {\n    const colors = {\n      scheduled: '#3B82F6',\n      // Blue\n      confirmed: '#10B981',\n      // Green\n      in_progress: '#F59E0B',\n      // Amber\n      completed: '#059669',\n      // Emerald\n      cancelled: '#EF4444',\n      // Red\n      no_show: '#6B7280' // Gray\n    };\n    return colors[status] || '#6B7280';\n  };\n\n  /** Format date for display */\n  const formatDate = dateStr => {\n    if (!dateStr) return '—';\n    try {\n      return new Date(dateStr).toLocaleDateString('en-IN', {\n        day: 'numeric',\n        month: 'short',\n        year: 'numeric'\n      });\n    } catch {\n      return dateStr;\n    }\n  };\n\n  /** Format time for display */\n  const formatTime = dateStr => {\n    if (!dateStr) return '—';\n    try {\n      return new Date(dateStr).toLocaleTimeString('en-IN', {\n        hour: '2-digit',\n        minute: '2-digit',\n        hour12: true\n      });\n    } catch {\n      return dateStr;\n    }\n  };\n\n  /** Format date and time for display */\n  const formatDateTime = dateStr => {\n    if (!dateStr) return '—';\n    try {\n      return new Date(dateStr).toLocaleString('en-IN', {\n        day: 'numeric',\n        month: 'short',\n        hour: '2-digit',\n        minute: '2-digit',\n        hour12: true\n      });\n    } catch {\n      return dateStr;\n    }\n  };\n\n  /** Calculate appointment duration in minutes */\n  const calculateDuration = (start, end) => {\n    if (!end) return null;\n    const startDate = new Date(start);\n    const endDate = new Date(end);\n    return Math.round((endDate.getTime() - startDate.getTime()) / (1000 * 60));\n  };\n\n  /** Format duration for display */\n  const formatDuration = minutes => {\n    if (!minutes) return '—';\n    if (minutes < 60) return `${minutes} min`;\n    const hours = Math.floor(minutes / 60);\n    const mins = minutes % 60;\n    if (mins === 0) return `${hours} hr`;\n    return `${hours} hr ${mins} min`;\n  };\n\n  /** Status options for filtering */\n  const APPOINTMENT_STATUSES = ['scheduled', 'confirmed', 'in_progress', 'completed', 'cancelled', 'no_show'];\n\n  // ============================================\n  // ENHANCED DTOs FOR WORKFLOW\n  // ============================================\n\n  /** Appointment type */\n\n  /** Staff info in responses */\n\n  /** Room info in responses */\n\n  /** Enhanced appointment response with expanded fields */\n\n  /** Daily summary for appointments */\n\n  /** List appointments response with summary */\n\n  /** Available slot */\n\n  /** Available slots request */\n\n  /** Available slots response */\n\n  /** Available therapist for multi-slot */\n\n  /** Validation request */\n\n  /** Conflict info */\n\n  /** Validation response */\n\n  /** Alternative slot for conflict resolution */\n\n  /** Session in therapy plan - matches API response */\n\n  /** Therapy plan request */\n\n  /** Therapy plan response - matches API spec */\n\n  /** Bulk create appointment item */\n\n  /** Bulk create request */\n\n  /** Created appointment summary */\n\n  /** Bulk create response */\n\n  /** Search appointments params */\n\n  // ============================================\n  // WHATSAPP HELPERS\n  // ============================================\n\n  /** Get role label based on appointment type or staff role */\n  const getRoleLabel = (appointmentType, staffRole) => {\n    // If appointment type explicitly indicates doctor consultation\n    if (appointmentType?.toUpperCase() === 'DOCTOR_CONSULTATION' || appointmentType?.toUpperCase() === 'CONSULTATION' || appointmentType?.toUpperCase() === 'DOCTOR') {\n      return 'Doctor';\n    }\n\n    // If appointment type explicitly indicates therapy\n    if (appointmentType?.toUpperCase() === 'THERAPY' || appointmentType?.toUpperCase() === 'THERAPY_SESSION' || appointmentType?.toUpperCase() === 'MULTI') {\n      return 'Therapist';\n    }\n\n    // Check staff role/type\n    const role = (staffRole || '').toLowerCase();\n    if (role.includes('doctor') || role.includes('vaidya') || role.includes('physician')) {\n      return 'Doctor';\n    }\n    if (role.includes('therapist')) {\n      return 'Therapist';\n    }\n\n    // Default fallback\n    return 'Staff';\n  };\n\n  /** Generate WhatsApp confirmation message */\n  const generateWhatsAppConfirmationMessage = (clientName, clinicName, date, time, staffName, treatmentName, clinicPhone, appointmentType) => {\n    const roleLabel = getRoleLabel(appointmentType);\n    return `Hi ${clientName},\n\nYour appointment has been confirmed! 📅\n\n📍 Clinic: ${clinicName}\n📅 Date: ${date}\n🕐 Time: ${time}\n👨‍⚕️ ${roleLabel}: ${staffName}\n💆 Treatment: ${treatmentName}\n\nPlease arrive 10 minutes early.\n\nFor any changes, please call us at ${clinicPhone}.\n\nThank you!`;\n  };\n\n  /** Generate WhatsApp cancellation message */\n  const generateWhatsAppCancellationMessage = (clientName, date, time, treatmentName, clinicPhone) => {\n    return `Hi ${clientName},\n\nYour appointment has been cancelled. ❌\n\n📅 Date: ${date}\n🕐 Time: ${time}\n💆 Treatment: ${treatmentName}\n\nIf you'd like to reschedule, please call us at ${clinicPhone}.\n\nThank you!`;\n  };\n\n  /** Generate WhatsApp reschedule message */\n  const generateWhatsAppRescheduleMessage = (clientName, oldDate, oldTime, newDate, newTime, staffName, treatmentName, appointmentType) => {\n    const roleLabel = getRoleLabel(appointmentType);\n    return `Hi ${clientName},\n\nYour appointment has been rescheduled. 📅\n\nPrevious:\n📅 ${oldDate} at ${oldTime}\n\nNew:\n📅 ${newDate} at ${newTime}\n👨‍⚕️ ${roleLabel}: ${staffName}\n💆 Treatment: ${treatmentName}\n\nPlease confirm if this works for you.\n\nThank you!`;\n  };\n\n  /** Generate WhatsApp multi-slot confirmation message */\n  const generateWhatsAppSeriesMessage = (clientName, clinicName, treatmentName, totalSessions, firstSessionDate, firstSessionTime, clinicPhone) => {\n    return `Hi ${clientName},\n\nYour therapy plan has been scheduled! 📅\n\n📍 Clinic: ${clinicName}\n💆 Treatment: ${treatmentName}\n📊 Total Sessions: ${totalSessions}\n\nFirst Session:\n📅 ${firstSessionDate} at ${firstSessionTime}\n\nYou will receive reminders before each session.\n\nFor any changes, please call us at ${clinicPhone}.\n\nThank you!`;\n  };\n\n  /** Open WhatsApp with pre-filled message */\n  const openWhatsApp = (phone, message) => {\n    // Clean phone number - remove non-numeric except +\n    const cleanPhone = phone.replace(/[^\\d+]/g, '');\n    const encodedMessage = encodeURIComponent(message);\n    return `https://wa.me/${cleanPhone}?text=${encodedMessage}`;\n  };\n\n  /** Generate WhatsApp no-show message */\n  const generateWhatsAppNoShowMessage = (clientName, date, time, treatmentName, clinicPhone) => {\n    return `Hi ${clientName},\n\nWe noticed you missed your appointment today.\n\n📅 Date: ${date}\n🕐 Time: ${time}\n💆 Treatment: ${treatmentName}\n\nWe hope everything is okay! If you'd like to reschedule, please call us at ${clinicPhone}.\n\nThank you!`;\n  };\n\n  /** Generate WhatsApp appointment completed message */\n  const generateWhatsAppCompletedMessage = (clientName, date, treatmentName, clinicPhone) => {\n    return `Hi ${clientName},\n\nThank you for visiting us today! 🙏\n\n💆 Treatment: ${treatmentName}\n📅 Date: ${date}\n\nWe hope you had a great experience. If you have any questions or need to book your next appointment, please call us at ${clinicPhone}.\n\nTake care and see you soon!`;\n  };\n\n  /** Generate WhatsApp appointment created message */\n  const generateWhatsAppCreatedMessage = (clientName, clinicName, date, time, staffName, treatmentName, clinicPhone, appointmentType) => {\n    const roleLabel = getRoleLabel(appointmentType);\n    return `Hi ${clientName},\n\nYour appointment has been booked! 📅\n\n📍 Clinic: ${clinicName}\n📅 Date: ${date}\n🕐 Time: ${time}\n👨‍⚕️ ${roleLabel}: ${staffName}\n💆 Treatment: ${treatmentName}\n\nPlease arrive 10 minutes early.\n\nFor any changes, please call us at ${clinicPhone}.\n\nThank you!`;\n  };\n\n  /** Format short date for display */\n  const formatShortDate = dateStr => {\n    if (!dateStr) return '—';\n    try {\n      return new Date(dateStr).toLocaleDateString('en-IN', {\n        day: 'numeric',\n        month: 'short'\n      });\n    } catch {\n      return dateStr;\n    }\n  };\n\n  /** Format day of week */\n  const formatDayOfWeek = dateStr => {\n    try {\n      return new Date(dateStr).toLocaleDateString('en-IN', {\n        weekday: 'short'\n      });\n    } catch {\n      return '';\n    }\n  };\n\n  /** Check if date is today */\n  const isToday = dateStr => {\n    const today = new Date();\n    const date = new Date(dateStr);\n    return date.getDate() === today.getDate() && date.getMonth() === today.getMonth() && date.getFullYear() === today.getFullYear();\n  };\n\n  /** Generate date range for date slider */\n  const generateDateRange = (centerDate, daysAround =