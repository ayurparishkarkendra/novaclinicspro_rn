el(appointmentType);\n    return `Hi ${clientName},\n\nYour appointment has been rescheduled. 📅\n\nPrevious:\n📅 ${oldDate} at ${oldTime}\n\nNew:\n📅 ${newDate} at ${newTime}\n👨‍⚕️ ${roleLabel}: ${staffName}\n💆 Treatment: ${treatmentName}\n\nPlease confirm if this works for you.\n\nThank you!`;\n  };\n\n  /** Generate WhatsApp multi-slot confirmation message */\n  const generateWhatsAppSeriesMessage = (clientName, clinicName, treatmentName, totalSessions, firstSessionDate, firstSessionTime, clinicPhone) => {\n    return `Hi ${clientName},\n\nYour therapy plan has been scheduled! 📅\n\n📍 Clinic: ${clinicName}\n💆 Treatment: ${treatmentName}\n📊 Total Sessions: ${totalSessions}\n\nFirst Session:\n📅 ${firstSessionDate} at ${firstSessionTime}\n\nYou will receive reminders before each session.\n\nFor any changes, please call us at ${clinicPhone}.\n\nThank you!`;\n  };\n\n  /** Open WhatsApp with pre-filled message */\n  const openWhatsApp = (phone, message) => {\n    // Clean phone number - remove non-numeric except +\n    const cleanPhone = phone.replace(/[^\\d+]/g, '');\n    const encodedMessage = encodeURIComponent(message);\n    return `https://wa.me/${cleanPhone}?text=${encodedMessage}`;\n  };\n\n  /** Generate WhatsApp no-show message */\n  const generateWhatsAppNoShowMessage = (clientName, date, time, treatmentName, clinicPhone) => {\n    return `Hi ${clientName},\n\nWe noticed you missed your appointment today.\n\n📅 Date: ${date}\n🕐 Time: ${time}\n💆 Treatment: ${treatmentName}\n\nWe hope everything is okay! If you'd like to reschedule, please call us at ${clinicPhone}.\n\nThank you!`;\n  };\n\n  /** Generate WhatsApp appointment completed message */\n  const generateWhatsAppCompletedMessage = (clientName, date, treatmentName, clinicPhone) => {\n    return `Hi ${clientName},\n\nThank you for visiting us today! 🙏\n\n💆 Treatment: ${treatmentName}\n📅 Date: ${date}\n\nWe hope you had a great experience. If you have any questions or need to book your next appointment, please call us at ${clinicPhone}.\n\nTake care and see you soon!`;\n  };\n\n  /** Generate WhatsApp appointment created message */\n  const generateWhatsAppCreatedMessage = (clientName, clinicName, date, time, staffName, treatmentName, clinicPhone, appointmentType) => {\n    const roleLabel = getRoleLabel(appointmentType);\n    return `Hi ${clientName},\n\nYour appointment has been booked! 📅\n\n📍 Clinic: ${clinicName}\n📅 Date: ${date}\n🕐 Time: ${time}\n👨‍⚕️ ${roleLabel}: ${staffName}\n💆 Treatment: ${treatmentName}\n\nPlease arrive 10 minutes early.\n\nFor any changes, please call us at ${clinicPhone}.\n\nThank you!`;\n  };\n\n  /** Format short date for display */\n  const formatShortDate = dateStr => {\n    if (!dateStr) return '—';\n    try {\n      return new Date(dateStr).toLocaleDateString('en-IN', {\n        day: 'numeric',\n        month: 'short'\n      });\n    } catch {\n      return dateStr;\n    }\n  };\n\n  /** Format day of week */\n  const formatDayOfWeek = dateStr => {\n    try {\n      return new Date(dateStr).toLocaleDateString('en-IN', {\n        weekday: 'short'\n      });\n    } catch {\n      return '';\n    }\n  };\n\n  /** Check if date is today */\n  const isToday = dateStr => {\n    const today = new Date();\n    const date = new Date(dateStr);\n    return date.getDate() === today.getDate() && date.getMonth() === today.getMonth() && date.getFullYear() === today.getFullYear();\n  };\n\n  /** Generate date range for date slider */\n  const generateDateRange = (centerDate, daysAround = 7) => {\n    const dates = [];\n    for (let i = -daysAround; i <= daysAround; i++) {\n      const date = new Date(centerDate);\n      date.setDate(centerDate.getDate() + i);\n      dates.push(date);\n    }\n    return dates;\n  };\n\n  /** Format ISO date string (YYYY-MM-DD) */\n  const toISODateString = date => {\n    return date.toISOString().split('T')[0];\n  };\n});","lineCount":621,"map":[[7,2,134,0,"Object"],[7,8,134,0],[7,9,134,0,"defineProperty"],[7,23,134,0]